    {
      "name": "Create Task or Get Last Created",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let currentId = pm.collectionVariables.get(\"id\");\r",
              "\r",
              "if (!currentId) {\r",
              "    const taskData = {\r",
              "        \"text\": \"Привет! Эта зопрас на испровление 111 текста\",\r",
              "        \"language\": \"RU\"\r",
              "    };\r",
              "\r",
              "    const request = {\r",
              "        url: \"http://localhost:8080/tasks\",\r",
              "        method: \"POST\",\r",
              "        header: { \"Content-Type\": \"application/json\" },\r",
              "        body: {\r",
              "            mode: \"raw\",\r",
              "            raw: JSON.stringify(taskData)\r",
              "        }\r",
              "    };\r",
              "\r",
              "    pm.sendRequest(request, function (err, response) {\r",
              "        if (err) {\r",
              "            console.error(\"Ошибка при создании задачи:\", err);\r",
              "            return;\r",
              "        }\r",
              "\r",
              "        if (response.code === 201) {\r",
              "            let responseData = response.json();\r",
              "            pm.collectionVariables.set(\"id\", responseData.taskId);\r",
              "        } else {\r",
              "            console.error(\"Сервер вернул ошибку при создании:\", response.code, response.text());\r",
              "        }\r",
              "    });\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {\r",
